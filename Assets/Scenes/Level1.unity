    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: 'dialogueMessages.Array.data[1]'
      value: Can you help me out of here?
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: 'dialogueMessages.Array.data[2]'
      value: '>...Me?'
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: 'dialogueMessages.Array.data[3]'
      value: Yes you! I need to escape this place.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
