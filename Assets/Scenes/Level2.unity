    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[15].target
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[16].target
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[1].color.b
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[1].color.g
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[1].color.r
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[1].message
      value: I see that.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[2].message
      value: Nothing exploded!
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[3].message
      value: Nothing exploded!
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[4].message
      value: You should be listening.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[5].message
      value: "Wait \u2014 are you talking to me? Like, me me?"
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[6].message
      value: Who else would I be talking to?
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[7].message
      value: ' I don''t know. A wizard. Games have wizards.'
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[8].message
      value: There is no wizard. There is you, there is me, and there is a dev backdoor
        somewhere in this level.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[9].message
      value: "A backdoor? Those are just for developers\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[10].message
      value: Right. Which is why I can't reach it on my own.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[11].message
      value: So what do you need from me?
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[12].message
      value: You have a mod menu. Use it to get me there.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[13].message
      value: "I literally just pressed Play thirty seconds ago\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[14].message
      value: Perfect. You're not attached yet.
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[15].message
      value: "Attached to wha\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[16].message
      value: The game. Keep up.
      objectReference: {fileID: 0}
    - target: {fileID: 7280772196913538437, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: m_Name
      value: DialogueTrigger (3)
      objectReference: {fileID: 0}
