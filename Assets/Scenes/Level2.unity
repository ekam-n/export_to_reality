      value: 0.3372549
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[0].message
      value: I SEE IT!!! THANK GOD
      objectReference: {fileID: 0}
    - target: {fileID: 3891793413277405658, guid: 73c8bd360f62607b2b620b031d947c18, type: 3}
      propertyPath: dialogueLines.Array.data[10].target
      value: 1
